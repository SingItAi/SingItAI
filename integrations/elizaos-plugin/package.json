{
  "name": "@singitai/plugin-singit",
  "version": "0.1.0",
  "description": "ElizaOS plugin for SingIt: free crypto/FX prices and model listing via SingIt's MCP server, optional paid web search/page reading with a SingIt API key, and optional x402-paid chat on SingIt Ask (Base).",
  "type": "module",
  "main": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "elizaos",
    "elizaos-plugins",
    "elizaos-plugin",
    "singit",
    "mcp",
    "x402",
    "model-context-protocol"
  ],
  "homepage": "https://singitai.app/developers/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bubon-ik/SingItAI",
    "directory": "integrations/elizaos-plugin"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@elizaos/core": "^1.7.0"
  },
  "dependencies": {
    "@x402/evm": "2.28.0",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@elizaos/core": "1.7.2"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
