{
  "name": "@singitai/proxy",
  "version": "0.1.0",
  "description": "Local OpenAI-compatible proxy that pays SingIt Ask over x402 from a keyless wallet in ~/.singit/session. No API key needed.",
  "keywords": [
    "singit",
    "x402",
    "openai",
    "proxy",
    "usdc",
    "base",
    "ai-agents"
  ],
  "homepage": "https://singitai.app/developers/",
  "bugs": {
    "url": "https://github.com/SingItAi/SingItAI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SingItAi/SingItAI.git",
    "directory": "proxy"
  },
  "license": "MIT",
  "author": "SingIt <contact@singitai.app>",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "singit-proxy": "src/index.js",
    "singit-cc": "src/cc.js",
    "singit-codex": "src/codex.js",
    "singit-openclaw": "src/openclaw.js"
  },
  "exports": {
    ".": "./src/server.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@singitai/sdk": "file:../sdk/typescript",
    "@singitai/session-wallet": "file:../session-wallet"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
