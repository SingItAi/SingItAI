[Unit]
Description=SingIt Ask (x402 model answers on loopback)
After=network-online.target

[Service]
Type=simple
# Substitute these three paths from private ops notes before installing.
# <APP_CHECKOUT>/singit-ask, <ASK_CONFIG_DIR>/service.env, <AGENT_HOME>/node/bin/node
WorkingDirectory=<APP_CHECKOUT>/singit-ask
EnvironmentFile=<ASK_CONFIG_DIR>/service.env
ExecStart=<AGENT_HOME>/node/bin/node src/server.mjs
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
TimeoutStopSec=15

[Install]
WantedBy=default.target
