# The web app lives on app.singitai.app, where its API is (/web/v1). The copy of website/app that
# Cloudflare would serve here cannot reach that API, so old links and bookmarks go to the real app.
# 302, not 301: browsers keep a 301 forever, and this host may serve something under /app/ one day.
/app https://app.singitai.app/app/ 302
/app/* https://app.singitai.app/app/:splat 302

# singitai.app/numbers.json is served live by ask.singitai.app.
/numbers.json https://ask.singitai.app/numbers.json 302

# Consolidated into /agent-spending-limits/; 301 because the move is permanent.
/ai-agent-spending-limit /agent-spending-limits/ 301
/ai-agent-spending-limit/ /agent-spending-limits/ 301

# Do not add a catch-all rewrite to /index.html. Cloudflare Pages serves a real
# file before the dashboard SPA fallback, which is why /robots.txt and
# /sitemap.xml used to return the landing HTML: the files were missing.
# A splat rule here would hide them again.
# generated:hidden-models:start
# Temporarily hidden, see scripts/hidden-models.json
# generated:hidden-models:end
