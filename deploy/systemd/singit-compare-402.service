# TEMPLATE ONLY. This unit is NOT installed or enabled by anything in this repository.
# Installing it (and singit-compare-402.timer) on a host needs the owner's OK. It is a USER unit:
# copy both to ~/.config/systemd/user/, point ExecStart at the real checkout, `systemctl --user daemon-reload`,
# then `systemctl --user enable --now singit-compare-402.timer`.
#
# One run sends 8 unpaid POSTs (four models, ours and BlockRun's), no payment header, no key, no wallet; it appends
# one JSON line to the history file. It exits 2 when SingIt's cheapest Base price is above BlockRun's for any model.
# That is a price alert, not a failure: SuccessExitStatus=2 below keeps the unit out of the systemd `failed` state, so
# `failed` means the script itself broke (exit 1 crash or usage error, 3 with --strict and a failed probe, a timeout).
# The alert is in the journal ("← ALERT" on the model's line; `journalctl --user -u singit-compare-402`) and in the
# `alerts` array of the history line. After a change to this file, re-copy it to ~/.config/systemd/user/ and
# `systemctl --user daemon-reload`, then `systemctl --user reset-failed singit-compare-402.service` once.

[Unit]
Description=SingIt vs BlockRun: compare the unpaid x402 402 prices for one short chat answer
Documentation=file://%h/SingItAI/scripts/README.md

[Service]
Type=oneshot
# Placeholder paths: point them at the real checkout and a state directory.
ExecStart=/usr/bin/node %h/SingItAI/scripts/compare-402-blockrun.mjs --append %h/.local/state/singit/compare-402.jsonl
SuccessExitStatus=2
TimeoutStartSec=120
Nice=10
